<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDMS.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IDMS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <div class="sidebar-brand">IDMS Web</div>
                <nav class="nav flex-column gap-1">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-controller="MasterBrand" asp-action="Index">Master Brand</a>
                    <a class="nav-link" asp-controller="MasterType" asp-action="Index">Master Type</a>
                    <a class="nav-link" asp-controller="MasterModel" asp-action="Index">Master Model</a>
                    <a class="nav-link" asp-controller="MasterStock" asp-action="Index">Master Stock</a>
                </nav>
            </aside>

            <div class="app-content">
                <header class="topbar">
                    <div>
                        <strong>@ViewData["Title"]</strong>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small">@User.Identity?.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                        </form>
                    </div>
                </header>

                <main role="main" class="content-body">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="container py-4">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
