<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDMS.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IDMS.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell-body">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isHomeActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
        var isMasterBrandActive = string.Equals(currentController, "MasterBrand", StringComparison.OrdinalIgnoreCase);
        var isMasterTypeActive = string.Equals(currentController, "MasterType", StringComparison.OrdinalIgnoreCase);
    }

    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-sidebar-header">
                <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">IDMS</a>
                <p class="app-sidebar-subtitle mb-0">Dashboard</p>
            </div>

            <nav class="nav flex-column app-nav">
                <a class="nav-link @(isHomeActive ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link @(isMasterBrandActive ? "active" : "")" asp-controller="MasterBrand" asp-action="Index">Master Brand</a>
                <a class="nav-link @(isMasterTypeActive ? "active" : "")" asp-controller="MasterType" asp-action="Index">Master Type</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link app-nav-logout" asp-controller="Auth" asp-action="Logout">Logout</a>
                }
            </nav>
        </aside>

        <main role="main" class="app-main">
            <div class="app-main-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
