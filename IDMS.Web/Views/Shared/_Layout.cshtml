<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDMS Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="global-3d-wrapper">
        <script type="module" src="https://unpkg.com/@@splinetool/viewer@1.12.69/build/spline-viewer.js"></script>
        <spline-viewer url="https://prod.spline.design/RuMjqn1WjhiFFi7J/scene.splinecode"></spline-viewer>
    </div>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var isHomeActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
        var isMasterBrandActive = string.Equals(currentController, "MasterBrand", StringComparison.OrdinalIgnoreCase);
        var isMasterTypeActive = string.Equals(currentController, "MasterType", StringComparison.OrdinalIgnoreCase);
        var isMasterModelActive = string.Equals(currentController, "MasterModel", StringComparison.OrdinalIgnoreCase);
        var isMasterStockActive = string.Equals(currentController, "MasterStock", StringComparison.OrdinalIgnoreCase);
    }

    <div class="app-shell">

        <aside class="app-sidebar glass-panel">
            <div class="text-center mb-4">
                <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">IDMS.</a>
                <p class="app-sidebar-subtitle">Analyst Portal</p>
            </div>

            <nav class="nav flex-column app-nav">
                <a class="nav-link @(isHomeActive ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="me-3">🏠</span> Dashboard
                </a>

                <div class="nav-divider">Master Data</div>

                <a class="nav-link @(isMasterBrandActive ? "active" : "")" asp-controller="MasterBrand"
                       asp-action="Index">
                    <span class="me-3">🏷️</span> Brand
                </a>
                <a class="nav-link @(isMasterTypeActive ? "active" : "")" asp-controller="MasterType"
                       asp-action="Index">
                    <span class="me-3">📦</span> Type
                </a>
                <a class="nav-link @(isMasterModelActive ? "active" : "")" asp-controller="MasterModel"
                       asp-action="Index">
                    <span class="me-3">🚗</span> Model
                </a>
                <a class="nav-link @(isMasterStockActive ? "active" : "")" asp-controller="MasterStock"
                       asp-action="Index">
                    <span class="me-3">📋</span> Stock
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link mt-auto" style="color: #ff453a !important; background: rgba(255, 69, 58, 0.1);"
                           asp-controller="Auth" asp-action="Logout">
                        <span class="me-3">🚪</span> Secure Logout
                    </a>
                }
            </nav>
        </aside>

        <main role="main" class="app-main">
            <div class="app-main-content glass-panel">
                @RenderBody()
            </div>
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>