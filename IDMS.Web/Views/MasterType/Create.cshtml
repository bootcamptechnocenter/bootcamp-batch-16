@using IDMS.Modules.Master.Dto.Request
@using Microsoft.AspNetCore.Mvc.Rendering
@model ReqCreateMstTypeDto

@{
    ViewData["Title"] = "Create Master Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create Master Type</h2>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.BrandOptions">
            <option value="">Select Brand</option>
        </select>
        <span asp-validation-for="BrandId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}