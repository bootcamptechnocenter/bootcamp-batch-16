@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstTypeDto>;

@{
    ViewData["Title"] = "Master Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Master Types</h2>
<div>
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Type</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    ID
                </th>
                <th>
                    Brand
                </th>
                <th>
                    Type Code
                </th>
                <th>
                    Type Name
                </th>
                <th>
                    Is Active
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Brand)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @(item.IsActive ? "YES" : "NO")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Edit</a> |
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this item?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @{
        var pagination = Model.Pagination;
    }
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(!pagination.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage - 1)" asp-route-limit="@pagination.Limit">Previous</a>
            </li>
            @for (int i = 1; i <= pagination.TotalPages; i++)
            {
                <li class="page-item @(i == pagination.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-limit="@pagination.Limit">@i</a>
                </li>
            }
            <li class="page-item @(!pagination.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage + 1)" asp-route-limit="@pagination.Limit">Next</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Page @pagination.CurrentPage of @pagination.TotalPages (Total: @pagination.TotalItems items)</p>
</div>