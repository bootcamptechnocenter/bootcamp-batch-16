@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstTypeDto>;

@{
    ViewData["Title"] = "Master Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentLimit = Model.Pagination.Limit;
}

<div class="page-header">
    <div>
        <h4><i class="bi bi-tags me-2 text-primary"></i>Master Types</h4>
        <p class="page-subtitle">Manage vehicle types per brand</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Type
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="limit" value="@currentLimit" />
            <i class="bi bi-search text-muted"></i>
            <input type="text" name="search" class="form-control form-control-sm border-0 shadow-none"
                   style="max-width:300px" placeholder="Search types..." value="@currentSearch" />
            <span class="vr mx-2 opacity-25"></span>
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a asp-action="Index" asp-route-limit="@currentLimit" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div id="table-wrapper">
    @await Html.PartialAsync("_IndexTable", Model)
</div>
