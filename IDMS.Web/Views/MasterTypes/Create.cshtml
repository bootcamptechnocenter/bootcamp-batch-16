@using IDMS.Modules.Master.Dto.Request
@model ReqCreateTypeDto;

@{
    ViewData["Title"] = "Create Master Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create Master Type</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="BrandId" class="control-label"></label>
        <select asp-for="BrandId" asp-items="ViewBag.BrandList" class="form-control">
            <option value="">-- Select Brand --</option>
        </select>
        <span asp-validation-for="BrandId" class="text-danger"/>
    </div>
    <br/>   
    <div class="form-group">
        <label asp-for="Code" class="control-label"/>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"/>
    </div>
    <br/>   
    <div class="form-group">
        <label asp-for="Name" class="control-label"/>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"/>
    </div>
    <br/>
    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input"/>
        <label asp-for="IsActive" class="form-check-label"/>
    </div>
    <br/>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>