@using IDMS.Modules.Master.Dto.Request
@model ReqCreateTypeDto;

@{
    ViewData["Title"] = "Create Master Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Create Master Type</h4>
        <p class="text-muted small mb-0">Add a new type to the system</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

<div class="card shadow-sm border-0" style="max-width: 540px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="BrandId" class="form-label"></label>
                <select asp-for="BrandId" asp-items="ViewBag.BrandList" class="form-select">
                    <option value="">-- Select Brand --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger small"/>
            </div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input"/>
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="d-flex gap-2">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>