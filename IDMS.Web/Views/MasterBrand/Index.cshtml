@using IDMS.Modules.Master.Dto.Response
@using IDMS.Modules.Master.Services;
@using IDMS.Shared.Entities
@model PagedResult<ResMstBrandDto>

@{
    ViewData["Title"] = "Master Brand";
    var search = Context.Request.Query["search"].ToString();
    // Pagination vars dll tetap aman
}

<div class="master-brand-page py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-white" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Master Brand</h2>
            <p class="mb-0" style="color: rgba(255,255,255,0.6);">Manage and organize brand data efficiently.</p>
        </div>
        <button type="button" class="btn fw-semibold"
                style="background: #fff; color: #000; border-radius: 16px; padding: 12px 24px; box-shadow: 0 8px 20px rgba(0,0,0,0.3);"
                onclick="showFormModal('@Url.Action("Create")')">
            + Create New
        </button>
    </div>

    <div class="card border-0 bg-transparent rounded-4 glass-panel">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end mb-4">
                <div class="col-12 col-md-8">
                    <label class="form-label small fw-semibold"
                           style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Search</label>
                    <input id="masterBrandSearch"                class="form-control"                        placeholder="Search brand data..."
                           value="@search" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold"
                           style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Show</label>
                    <select id="masterBrandLimit" class="form-control" style="appearance: auto;">
                        <option value="10" class="text-dark">10</option>
                        <option value="20" class="text-dark">20</option>
                        <option value="50" class="text-dark">50</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <button id="masterBrandReset"                        class="btn w-100 fw-semibold"
                            style="background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 16px; padding: 12px;">
                        Reset
                    </button>
                </div>
            </div>

            <div id="masterBrandGrid" data-url="@Url.Action("Table")">
                <partial name="_MasterBrandTable" model="Model" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brandFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-white" id="formModalTitle">Brand Form</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="formModalContent">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="brandDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content glass-panel border-0 rounded-4 shadow-lg text-center">
            <div class="modal-body p-4">
                <div class="mb-3" style="color: #ff453a;"><i class="fs-1 bi bi-exclamation-circle"></i></div>
                <h5 class="fw-bold text-white">Delete Brand?</h5>
                <p class="small" style="color: rgba(255,255,255,0.7);">Data <strong id="brandDeleteCode"
                                                                                        class="text-white"></strong> permanently deleted.</p>
                    <div class="d-flex gap-2 mt-4">
                        <button type="button" class="btn w-100 fw-semibold"
                                style="background: rgba(255,255,255,0.1); color: #fff; border-radius: 16px;"
                                data-bs-dismiss="modal">Cancel</button>
                        <form id="brandDeleteForm" method="post" class="w-100">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn w-100 fw-semibold shadow-sm"
                                    style="background: #ff453a; color: #fff; border-radius: 16px; border: none;">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

   @section Scripts {
    <script>
        // --- KODE SAKTI: Pindahkan semua modal ke <body> agar terbebas dari jebakan Glassmorphism ---
        document.querySelectorAll('.modal').forEach(m => document.body.appendChild(m));

        function showFormModal(url) {
            const isEdit = url.includes('Edit');
            $('#formModalTitle').text(isEdit ? 'Edit Brand' : 'Create New Brand');
            $('#formModalContent').html('<div class="text-center py-4"><div class="spinner-border text-light"></div></div>');
            $('#brandFormModal').modal('show');
            $('#formModalContent').load(url);
        }

        (() => {
            const grid = document.getElementById('masterBrandGrid');
            const searchInput = document.getElementById('masterBrandSearch');
            const limitSelect = document.getElementById('masterBrandLimit');
            const resetButton = document.getElementById('masterBrandReset');

            if (!grid || !searchInput || !limitSelect) return;

            const tableUrl = grid.dataset.url;
            const indexUrl = grid.dataset.indexUrl || window.location.pathname;
            let debounceTimer; let requestCounter = 0;

            const updateUrl = (page) => {
                const params = new URLSearchParams();
                const searchValue = searchInput.value.trim();
                const limitValue = limitSelect.value;
                if (searchValue) params.set('search', searchValue);
                if (limitValue && limitValue !== '10') params.set('limit', limitValue);
                if (page > 1) params.set('page', page.toString());
                const queryString = params.toString();
                const url = queryString ? `${indexUrl}?${queryString}` : indexUrl;
                history.replaceState({}, '', url);
            };

            const bindPager = () => {
                grid.querySelectorAll('[data-page]').forEach((link) => {
                    link.addEventListener('click', (event) => {
                        event.preventDefault();
                        if (link.closest('.disabled')) return;
                        const page = parseInt(link.dataset.page || '1', 10);
                        loadGrid(page);
                    });
                });
            };

            const loadGrid = (page = 1) => {
                const currentRequest = ++requestCounter;
                const searchValue = searchInput.value.trim();
                const limitValue = limitSelect.value;
                const url = `${tableUrl}?search=${encodeURIComponent(searchValue)}&limit=${encodeURIComponent(limitValue)}&page=${page}`;
                
                grid.style.opacity = '0.5';

                fetch(url, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.text())
                    .then(html => {
                        if (currentRequest !== requestCounter) return;
                        grid.innerHTML = html;
                        bindPager(); updateUrl(page);
                    })
                    .finally(() => {
                        if (currentRequest === requestCounter) grid.style.opacity = '1';
                    });
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer); debounceTimer = setTimeout(() => loadGrid(1), 350);
            });
            limitSelect.addEventListener('change', () => loadGrid(1));

            if (resetButton) {
                resetButton.addEventListener('click', () => {
                    searchInput.value = ''; limitSelect.value = '10'; loadGrid(1);
                });
            }
            bindPager();
        })();

        // Delete modal event
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.brand-delete-btn');
            if (!btn) return;
            const modal = document.getElementById('brandDeleteModal');
            if (!modal) return;

            document.getElementById('brandDeleteCode').textContent = btn.dataset.code ?? '—';
            document.getElementById('brandDeleteForm').action = `/MasterBrand/Delete/${btn.dataset.id}`;
            bootstrap.Modal.getOrCreateInstance(modal).show();
        });
    </script>
}