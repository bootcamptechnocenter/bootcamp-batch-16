@model IDMS.Modules.Master.Dto.Request.ReqUpdateMstBrandDto
@{
    Layout = null;
}

@* Gunakan asp-route-id agar ID dikirim melalui URL saat submit, 
   karena DTO Update kamu tidak memiliki properti 'Id' (penyebab error CS1061 tadi).
*@
<form asp-action="Edit" asp-route-id="@ViewBag.BrandId" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-4">
        <label asp-for="Code" class="form-label fw-bold small"
               style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Brand Code</label>
        @* Value otomatis terisi karena menggunakan asp-for *@
        <input asp-for="Code" class="form-control" placeholder="Contoh: BR-01" required
               style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="mb-5">
        <label asp-for="Name" class="form-label fw-bold small"
               style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Brand Name</label>
        @* Value otomatis terisi karena menggunakan asp-for *@
        <input asp-for="Name" class="form-control" placeholder="Nama Brand..." required
               style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn w-50 fw-semibold"
                style="background: rgba(255,255,255,0.1); color: #fff; border-radius: 16px; padding: 12px;"
                data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn w-50 fw-bold shadow-sm"
                style="background: #fff; color: #000; border-radius: 16px; padding: 12px;">Update Data</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}