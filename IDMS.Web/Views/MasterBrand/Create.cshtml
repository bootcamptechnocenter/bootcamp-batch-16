@model IDMS.Modules.Master.Dto.Request.ReqCreateMstBrandDto
@{
    Layout = null;
}

<form asp-action="Create" method="post">
    <div class="mb-4">
        <label asp-for="Code" class="form-label fw-bold small"
               style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Brand Code</label>
        <input asp-for="Code" class="form-control" placeholder="Contoh: BR-01" required />
    </div>
    <div class="mb-5">
        <label asp-for="Name" class="form-label fw-bold small"
               style="color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 1px;">Brand Name</label>
        <input asp-for="Name" class="form-control" placeholder="Nama Brand..." required />
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn w-50 fw-semibold"
                style="background: rgba(255,255,255,0.1); color: #fff; border-radius: 16px; padding: 12px;"
                data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn w-50 fw-bold shadow-sm"
                style="background: #fff; color: #000; border-radius: 16px; padding: 12px;">Save Data</button>
    </div>
</form>