@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstBrandDto>

<div class="table-responsive rounded-4 mb-3" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05);">
    <table class="table align-middle mb-0 text-white" style="--bs-table-bg: transparent; --bs-table-color: #fff;">
        <thead style="background: rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.1);">
            <tr>
                <th class="py-3 px-4" style="color: rgba(255,255,255,0.6);">No</th>
                <th class="py-3" style="color: rgba(255,255,255,0.6);">Brand Code</th>
                <th class="py-3" style="color: rgba(255,255,255,0.6);">Brand Name</th>
                <th class="py-3 text-center" style="color: rgba(255,255,255,0.6);">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Items?.Any() == true)
            {
                int no = ((Model.Pagination.CurrentPage - 1) * Model.Pagination.Limit) + 1;
                foreach (var brand in Model.Items)
                {
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <td class="px-4 py-3">@no</td>
                        <td class="fw-bold" style="color: #66b2ff;">@brand.Code</td>
                        <td>@brand.Name</td>
                        <td class="text-center">
                            <button class="btn btn-sm px-3 fw-semibold me-1"
                                    style="background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px;"
                                    onclick="showFormModal('@Url.Action("Edit", new { id = brand.Id })')">
                                Edit
                            </button>
                            <button class="btn btn-sm px-3 fw-semibold brand-delete-btn"
                                    style="background: rgba(255,69,58,0.15); color: #ffcccc; border: 1px solid rgba(255,69,58,0.3); border-radius: 12px;"
                                    data-id="@brand.Id" data-code="@brand.Code" data-name="@brand.Name">
                                Delete
                            </button>
                        </td>
                    </tr>
                    no++;
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center py-5" style="color: rgba(255,255,255,0.5);">
                        No data available
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model?.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center px-2">
        <div class="small fw-medium mb-2 mb-md-0" style="color: rgba(255,255,255,0.6);">
            Showing <strong class="text-white">@(((Model.Pagination.CurrentPage - 1) * Model.Pagination.Limit) + 1)</strong> to 
            <strong class="text-white">@(Math.Min(Model.Pagination.CurrentPage * Model.Pagination.Limit, Model.Pagination.TotalItems))</strong> of 
            <strong class="text-white">@Model.Pagination.TotalItems</strong> entries
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0 gap-1">
                <li class="page-item @(Model.Pagination.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link shadow-none" href="#" data-page="@(Model.Pagination.CurrentPage - 1)"
                       style="background: @(Model.Pagination.CurrentPage <= 1 ? "transparent" : "rgba(255,255,255,0.05)"); border: 1px solid rgba(255,255,255,0.1); color: @(Model.Pagination.CurrentPage <= 1 ? "rgba(255,255,255,0.3)" : "#fff"); border-radius: 8px;">
                        &laquo; Prev
                    </a>
                </li>

                @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                        <a class="page-link shadow-none fw-semibold" href="#" data-page="@i"
                           style="background: @(i == Model.Pagination.CurrentPage ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); border: 1px solid @(i == Model.Pagination.CurrentPage ? "rgba(255,255,255,0.4)" : "rgba(255,255,255,0.1)"); color: #fff; border-radius: 8px;">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Pagination.CurrentPage >= Model.Pagination.TotalPages ? "disabled" : "")">
                    <a class="page-link shadow-none" href="#" data-page="@(Model.Pagination.CurrentPage + 1)"
                       style="background: @(Model.Pagination.CurrentPage >= Model.Pagination.TotalPages ? "transparent" : "rgba(255,255,255,0.05)"); border: 1px solid rgba(255,255,255,0.1); color: @(Model.Pagination.CurrentPage >= Model.Pagination.TotalPages ? "rgba(255,255,255,0.3)" : "#fff"); border-radius: 8px;">
                        Next &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}