@using IDMS.Modules.Master.Dto.Request
@model ReqUpdateModelDto;

@{
    ViewData["Title"] = "Edit Model";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Edit Model</h4>
        <p class="text-muted small mb-0">Update vehicle model information</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

<div class="card shadow-sm border-0" style="max-width: 540px;">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            <div class="mb-3">
                <label class="form-label">Brand</label>
                <select id="brand-filter" asp-items="ViewBag.BrandList" class="form-select">
                    <option value="">-- Select Brand --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="TypeId" class="form-label"></label>
                <select id="TypeId" name="TypeId" class="form-select" disabled>
                    <option value="">-- Select Brand first --</option>
                </select>
                <span asp-validation-for="TypeId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" type="number" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const brandFilter  = document.getElementById('brand-filter');
        const typeSelect   = document.getElementById('TypeId');
        const initBrandId  = @ViewBag.CurrentBrandId;
        const initTypeId   = @Model.TypeId;

        async function loadTypes(brandId, selectedTypeId) {
            typeSelect.innerHTML = '<option value="">-- Select Type --</option>';
            typeSelect.disabled  = true;
            if (!brandId) return;
            const res   = await fetch(`/MasterModels/GetTypesByBrand?brandId=${brandId}`);
            const types = await res.json();
            types.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.textContent = t.name;
                if (t.id == selectedTypeId) opt.selected = true;
                typeSelect.appendChild(opt);
            });
            typeSelect.disabled = types.length === 0;
        }

        brandFilter.addEventListener('change', () => loadTypes(brandFilter.value, null));

        // Pre-populate on page load
        (async () => {
            if (initBrandId) {
                brandFilter.value = initBrandId;
                await loadTypes(initBrandId, initTypeId);
            }
        })();
    </script>
}
