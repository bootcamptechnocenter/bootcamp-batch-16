@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        html, body { height: 100%; margin: 0; }
        body {
            display: flex;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
            min-height: 100vh;
        }
        /* Left decorative panel */
        .login-panel-left {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            padding: 3rem 4rem;
            color: #e2e8f0;
        }
        .login-panel-left .brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.65rem;
            margin-bottom: 3rem;
        }
        .login-panel-left .brand-icon {
            width: 40px;
            height: 40px;
            background: #3b82f6;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-panel-left h1 {
            font-size: 2.4rem;
            font-weight: 800;
            line-height: 1.2;
            color: #fff;
            margin-bottom: 1rem;
        }
        .login-panel-left p {
            font-size: 1rem;
            color: #94a3b8;
            max-width: 380px;
        }
        .login-panel-left .feature-list {
            margin-top: 2.5rem;
            list-style: none;
            padding: 0;
        }
        .login-panel-left .feature-list li {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.9rem;
            color: #94a3b8;
            margin-bottom: 0.75rem;
        }
        .login-panel-left .feature-list li i {
            color: #3b82f6;
            font-size: 1rem;
        }
        /* Right form panel */
        .login-panel-right {
            width: 460px;
            min-height: 100vh;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            box-shadow: -8px 0 32px rgba(0,0,0,.3);
        }
        .login-form-inner { width: 100%; max-width: 360px; }
        .login-form-inner h4 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }
        .login-form-inner .subtitle {
            font-size: 0.88rem;
            color: #64748b;
            margin-bottom: 2rem;
        }
        .form-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.3rem;
        }
        .form-control {
            border-radius: 8px;
            border-color: #e2e8f0;
            padding: 0.65rem 0.9rem;
            font-size: 0.9rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            outline: none;
        }
        .btn-signin {
            background: #3b82f6;
            border: none;
            border-radius: 8px;
            padding: 0.7rem;
            font-weight: 600;
            font-size: 0.95rem;
            transition: background 0.18s, box-shadow 0.18s, transform 0.12s;
        }
        .btn-signin:hover {
            background: #2563eb;
            box-shadow: 0 4px 16px rgba(59,130,246,.35);
            transform: translateY(-1px);
        }
        .input-icon-wrap { position: relative; }
        .input-icon-wrap i {
            position: absolute;
            top: 50%;
            left: 0.85rem;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.95rem;
        }
        .input-icon-wrap .form-control { padding-left: 2.4rem; }
        @@media (max-width: 768px) {
            .login-panel-left { display: none; }
            .login-panel-right { width: 100%; box-shadow: none; }
        }
    </style>
</head>
<body>
    <!-- Left decorative panel -->
    <div class="login-panel-left">
        <div class="brand">
            <div class="brand-icon"><i class="bi bi-car-front-fill text-white"></i></div>
            IDMS
        </div>
        <h1>Inventory &amp;<br/>Dealer<br/>Management</h1>
        <p>A unified platform to manage your vehicle inventory, brands, models, and dealership operations.</p>
        <ul class="feature-list">
            <li><i class="bi bi-check-circle-fill"></i> Centralized stock management</li>
            <li><i class="bi bi-check-circle-fill"></i> Real-time inventory tracking</li>
            <li><i class="bi bi-check-circle-fill"></i> Multi-level master data</li>
            <li><i class="bi bi-check-circle-fill"></i> Secure role-based access</li>
        </ul>
    </div>

    <!-- Right form panel -->
    <div class="login-panel-right">
        <div class="login-form-inner">
            <h4>Welcome back</h4>
            <p class="subtitle">Sign in to your IDMS account to continue.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.Error
                </div>
            }

            <form method="post" asp-controller="Auth" asp-action="Login">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-envelope"></i>
                        <input type="email" class="form-control" id="email" name="email"
                               placeholder="you@example.com" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-lock"></i>
                        <input type="password" class="form-control" id="password" name="password"
                               placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-signin text-white w-100">
                    Sign in <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <p class="text-center text-muted mt-4 small">&copy; @DateTime.Now.Year IDMS</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

