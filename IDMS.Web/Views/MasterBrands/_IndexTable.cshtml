@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstBrandsDto>

@{
    var pagination = Model.Pagination;
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentLimit = pagination.Limit;
}

<div class="idms-table-card bg-white mb-0">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="ps-4">ID</th>
                <th>Code</th>
                <th>Name</th>
                <th class="pe-4 text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td class="ps-4 text-muted">#@item.Id</td>
                <td><span class="fw-medium">@item.Code</span></td>
                <td>@item.Name</td>
                <td class="pe-4 text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline"
                          onsubmit="return confirm('Delete this brand?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash3"></i> Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-3 d-block mb-1 opacity-25"></i>No records found.
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center gap-3 mt-3 flex-wrap">
    <p class="text-muted small mb-0">
        Page <strong>@pagination.CurrentPage</strong> of <strong>@pagination.TotalPages</strong>
        &mdash; <strong>@pagination.TotalItems</strong> total items
    </p>
    <div class="d-flex align-items-center gap-2">
        <form method="get" asp-action="Index">
            <input type="hidden" name="search" value="@currentSearch" />
            <select name="limit" class="form-select form-select-sm" style="width:110px">
                @foreach (var opt in new[] { 5, 10, 25 })
                {
                    if (currentLimit == opt)
                    {
                        <option value="@opt" selected>@opt / page</option>
                    }
                    else
                    {
                        <option value="@opt">@opt / page</option>
                    }
                }
            </select>
        </form>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!pagination.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage - 1)"
                       asp-route-limit="@currentLimit" asp-route-search="@currentSearch">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= pagination.TotalPages; i++)
                {
                    <li class="page-item @(i == pagination.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-limit="@currentLimit" asp-route-search="@currentSearch">@i</a>
                    </li>
                }
                <li class="page-item @(!pagination.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage + 1)"
                       asp-route-limit="@currentLimit" asp-route-search="@currentSearch">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>
