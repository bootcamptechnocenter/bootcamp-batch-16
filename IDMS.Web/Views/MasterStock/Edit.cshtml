@using IDMS.Modules.Master.Dto.Request
@model ReqUpdateMstStockDto

@{
    ViewData["Title"] = "Edit Master Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Master Stock</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.StockId" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="ModelId" class="form-label"></label>
        <input asp-for="ModelId" class="form-control" type="number" min="1" />
        <span asp-validation-for="ModelId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="JumlahStock" class="form-label"></label>
        <input asp-for="JumlahStock" class="form-control" type="number" min="0" />
        <span asp-validation-for="JumlahStock" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Harga" class="form-label"></label>
        <input asp-for="Harga" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="Harga" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
