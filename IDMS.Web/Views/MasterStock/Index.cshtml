@using IDMS.Modules.Master.Dto.Response
@using IDMS.Modules.Master.Services;
@using IDMS.Shared.Entities
@model PagedResult<ResMstStockDto>

@{
    ViewData["Title"] = "Master Stock";
    var search = Context.Request.Query["search"].ToString();
    var items = Model?.Items ?? Enumerable.Empty<ResMstStockDto>();
    var currentPage = Model?.Pagination?.CurrentPage > 0 ? Model.Pagination.CurrentPage : 1;
    var limit = Model?.Pagination?.Limit > 0 ? Model.Pagination.Limit : 10;
    var totalPages = Model?.Pagination?.TotalPages > 0 ? Model.Pagination.TotalPages : 1;
    var totalItems = Model?.Pagination?.TotalItems ?? 0;
}

<div class="master-model-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1">Master Stock</h2>
            <p class="text-muted mb-0">Manage and organize stock data.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="card master-model-card border-0">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3" id="masterStockFilters">
                <div class="col-12 col-md-6 col-lg-7">
                    <label for="masterStockSearch" class="form-label">Search</label>
                    <input id="masterStockSearch" value="@search" class="form-control" placeholder="Search by code or name" />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label for="masterStockLimit" class="form-label">Show</label>
                    <select id="masterStockLimit" class="form-select">
                        @foreach (var pageSize in new[] { 5, 10, 20, 50 })
                        {
                            if (limit == pageSize)
                            {
                                <option value="@pageSize" selected>@pageSize</option>
                            }
                            else
                            {
                                <option value="@pageSize">@pageSize</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-3 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="masterStockReset">Reset</button>
                </div>
            </div>

            <div id="masterStockGrid"
                 data-url="@Url.Action("Table", "MasterStock")"
                 data-index-url="@Url.Action("Index", "MasterStock")">
                <partial name="_MasterStockTable" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const grid = document.getElementById('masterStockGrid');
            const searchInput = document.getElementById('masterStockSearch');
            const limitSelect = document.getElementById('masterStockLimit');
            const resetButton = document.getElementById('masterStockReset');

            if (!grid || !searchInput || !limitSelect) {
                return;
            }

            const tableUrl = grid.dataset.url;
            const indexUrl = grid.dataset.indexUrl || window.location.pathname;
            let debounceTimer;
            let requestCounter = 0;

            const updateUrl = (page) => {
                const params = new URLSearchParams();
                const searchValue = searchInput.value.trim();
                const limitValue = limitSelect.value;

                if (searchValue) {
                    params.set('search', searchValue);
                }

                if (limitValue && limitValue !== '10') {
                    params.set('limit', limitValue);
                }

                if (page > 1) {
                    params.set('page', page.toString());
                }

                const queryString = params.toString();
                const url = queryString ? `${indexUrl}?${queryString}` : indexUrl;
                history.replaceState({}, '', url);
            };

            const bindPager = () => {
                grid.querySelectorAll('[data-page]').forEach((link) => {
                    link.addEventListener('click', (event) => {
                        event.preventDefault();

                        if (link.closest('.disabled')) {
                            return;
                        }

                        const page = parseInt(link.dataset.page || '1', 10);
                        loadGrid(page);
                    });
                });
            };

            const loadGrid = (page = 1) => {
                const currentRequest = ++requestCounter;
                const searchValue = searchInput.value.trim();
                const limitValue = limitSelect.value;
                const url = `${tableUrl}?search=${encodeURIComponent(searchValue)}&limit=${encodeURIComponent(limitValue)}&page=${page}`;

                grid.classList.add('master-stock-loading');

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(response => response.text())
                    .then(html => {
                        if (currentRequest !== requestCounter) {
                            return;
                        }

                        grid.innerHTML = html;
                        bindPager();
                        updateUrl(page);
                    })
                    .finally(() => {
                        if (currentRequest === requestCounter) {
                            grid.classList.remove('master-stock-loading');
                        }
                    });
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => loadGrid(1), 350);
            });

            limitSelect.addEventListener('change', () => loadGrid(1));

            if (resetButton) {
                resetButton.addEventListener('click', () => {
                    searchInput.value = '';
                    limitSelect.value = '10';
                    loadGrid(1);
                });
            }

            bindPager();
        })();

        // Delete modal — event delegation so it works after every AJAX re-render
        document.getElementById('masterStockGrid').addEventListener('click', (e) => {
        const btn = e.target.closest('.stock-delete-btn');
        if (!btn) return;

        const modal = document.getElementById('stockDeleteModal');
        if (!modal) return;

        // Fill modal correctly
        document.getElementById('stockDeleteModelId').textContent = btn.dataset.code ?? '—';
        document.getElementById('stockDeleteJumlahStock').textContent = btn.dataset.name ?? '—';
        document.getElementById('stockDeleteHarga').textContent = btn.dataset.year ?? '—';

        // Set form action
        document.getElementById('stockDeleteForm').action = `/MasterStock/Delete/${btn.dataset.id}`;

        bootstrap.Modal.getOrCreateInstance(modal).show();
        });
    </script>
}

