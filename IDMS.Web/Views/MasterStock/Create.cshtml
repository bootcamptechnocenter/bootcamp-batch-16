@model IDMS.Modules.Master.Dto.Request.ReqCreateMstStockDto

@{
    ViewData["Title"] = "Create Master Stock";
    var selectedBrandId = ViewBag.SelectedBrandId as int?;
    var selectedTypeId = ViewBag.SelectedTypeId as int?;
    var selectedBrandText = ViewBag.SelectedBrandText as string;
    var selectedTypeText = ViewBag.SelectedTypeText as string;
    var selectedModelText = ViewBag.SelectedModelText as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">Create Stock</h2>
        <p class="text-muted mb-0">Add new stock data into the system.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="card border-0" style="border-radius:1rem; box-shadow:0 8px 24px rgba(16,24,40,.06);">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="BrandId">Brand</label>
                        <select id="BrandId" name="BrandId" class="form-select"
                                data-select2-stock-brand="true"
                                data-ajax-url="@Url.Action("BrandOptions", "MasterStock")">
                            <option value="0">-- Select Brand --</option>
                            @if (selectedBrandId.HasValue && selectedBrandId.Value > 0 && !string.IsNullOrWhiteSpace(selectedBrandText))
                            {
                                <option value="@selectedBrandId" selected>@selectedBrandText</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="TypeId">Type</label>
                        <select id="TypeId" name="TypeId" class="form-select"
                                data-select2-stock-type="true"
                                data-brand-selector="#BrandId"
                                data-ajax-url="@Url.Action("TypeOptions", "MasterStock")">
                            <option value="0">-- Select Type --</option>
                            @if (selectedTypeId.HasValue && selectedTypeId.Value > 0 && !string.IsNullOrWhiteSpace(selectedTypeText))
                            {
                                <option value="@selectedTypeId" selected>@selectedTypeText</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="ModelId" class="form-label fw-semibold">Model</label>
                        <select asp-for="ModelId" class="form-select"
                                data-select2-stock-model="true"
                                data-type-selector="#TypeId"
                                data-ajax-url="@Url.Action("ModelOptions", "MasterStock")">
                            <option value="0">-- Select Model --</option>
                            @if (Model?.ModelId > 0 && !string.IsNullOrWhiteSpace(selectedModelText))
                            {
                                <option value="@Model.ModelId" selected>@selectedModelText</option>
                            }
                        </select>
                        <span asp-validation-for="ModelId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label for="JumlahStock" class="form-label fw-semibold">Jumlah Stock</label>
                        <input asp-for="JumlahStock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="JumlahStock" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label for="Harga" class="form-label fw-semibold">Harga</label>
                        <input asp-for="Harga" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Harga" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Stock</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/master-stock-form.js" asp-append-version="true"></script>
}
