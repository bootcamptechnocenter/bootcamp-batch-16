@using IDMS.Module.Master.Dto.Response
@using IDMS.Module.Master.Services;
@using IDMS.Shared.Entities
@using IDMS.Module.Master.Dto.Request
@model PageResult<RestMstStockDto>;

@{
    ViewData["Title"] = "Master Stocks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Master Stock</h2>
<div>
    <div class="mb-3">
        <div class="col-md-6">
            <!-- Search Form -->
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" 
                    name="search" 
                    class="form-control" 
                    placeholder="Search stock..." 
                    value="@Context.Request.Query["search"]" />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </form>
        </div>
        <button type="button" class="btn btn-primary" onclick="addNewRow()">+ Add New Stock</button>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Items.First().Id)</th>
                <th>Stock</th>
                <th>@Html.DisplayNameFor(model => model.Items.First().Price)</th>
                <th>@Html.DisplayNameFor(model => model.Items.First().Model!.Year)</th>
                <th>Model</th>
                <th>Type</th>
                <th>Brand</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="stockTableBody">
        @foreach (var item in Model.Items)
        {
            <tr id="row-@item.Id">
                <!-- View Mode -->
                <td class="view-mode">@item.Id</td>
                <td class="view-mode">@item.TotalStock</td>
                <td class="view-mode">@item.Price</td>
                <td class="view-mode">@item.Model?.Year</td>
                <td class="view-mode">@item.Model?.Name</td>
                <td class="view-mode">@item.Model?.Type?.Name</td>
                <td class="view-mode">@item.Model?.Type?.Brand?.Name</td>

                <!-- Edit Mode -->
                <td class="edit-mode d-none">@item.Id</td>
                <td class="edit-mode d-none">
                    <input type="number" class="form-control form-control-sm" id="totalStock-@item.Id" value="@item.TotalStock" min="1" />
                </td>
                <td class="edit-mode d-none">
                    <input type="number" class="form-control form-control-sm" id="price-@item.Id" value="@item.Price" min="0" step="0.01" />
                </td>
                <td class="edit-mode d-none">@item.Model?.Year</td>
                <td class="edit-mode d-none">@item.Model?.Name</td>
                <td class="edit-mode d-none">@item.Model?.Type?.Name</td>
                <td class="edit-mode d-none">@item.Model?.Type?.Brand?.Name</td>

                <td>
                    <!-- View Mode Buttons -->
                    <div class="view-mode">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="enableEdit(@item.Id)">Edit</button>
                        <button type="button" class="btn btn-sm btn-danger" 
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@item.Id">Delete</button>
                    </div>
                    <!-- Edit Mode Buttons -->
                    <div class="edit-mode d-none">
                        <button type="button" class="btn btn-sm btn-success" onclick="saveEdit(@item.Id, @item.Model!.Id)">Save</button>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="cancelEdit(@item.Id)">Cancel</button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @{
        var pagination = Model.Pagination;
    }
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(!pagination.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage - 1)" asp-route-limit="@pagination.Limit">Previous</a>
            </li>
            @for (int i = 1; i <= pagination.TotalPages; i++)
            {
                <li class="page-item @(i == pagination.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-limit="@pagination.Limit">@i</a>
                </li>
            }
            <li class="page-item @(!pagination.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(pagination.CurrentPage + 1)" asp-route-limit="@pagination.Limit">Next</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Page @pagination.CurrentPage of @pagination.TotalPages (Total: @pagination.TotalItems items)</p>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to delete this stock?</div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script id="availableModelsData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((IEnumerable<IDMS.Module.Master.Dto.Response.RestMstModelDto>)ViewBag.AvailableModels)
        .Select(m => new { 
            id = m.Id, 
            name = m.Name, 
            typeName = m.Type!.Name
        })
    ))
</script>

@section Scripts {
    <script>

         const availableModels = JSON.parse(document.getElementById('availableModelsData').textContent);
        // Enable edit mode for a row
        function enableEdit(id) {
            const row = document.getElementById(`row-${id}`);
            row.querySelectorAll('.view-mode').forEach(el => el.classList.add('d-none'));
            row.querySelectorAll('.edit-mode').forEach(el => el.classList.remove('d-none'));
        }

        // Cancel edit mode
        function cancelEdit(id) {
            const row = document.getElementById(`row-${id}`);
            row.querySelectorAll('.view-mode').forEach(el => el.classList.remove('d-none'));
            row.querySelectorAll('.edit-mode').forEach(el => el.classList.add('d-none'));
        }

        // Add new row
         function addNewRow() {
            // Remove existing new row if any
            const existingNewRow = document.getElementById('row-new');
            if (existingNewRow) existingNewRow.remove();

            // Build model options from available models
            let modelOptions = '<option value="">-- Select Model --</option>';
            availableModels.forEach(model => {
                modelOptions += `<option value="${model.id}">${model.name} (${model.typeName})</option>`;
            });

            const tbody = document.getElementById('stockTableBody');
            const newRow = document.createElement('tr');
            newRow.id = 'row-new';
            newRow.innerHTML = `
                <td><span class="text-muted">New</span></td>
                <td>
                    <input type="number" class="form-control form-control-sm" id="totalStock-new" placeholder="Total Stock" min="1" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" id="price-new" placeholder="Price" min="0" step="0.01" required />
                </td>
                <td colspan="3">
                    <select class="form-select form-select-sm" id="modelId-new">
                        ${modelOptions}
                    </select>
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-success" onclick="saveNewRow()">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="cancelNewRow()">Cancel</button>
                </td>
            `;
            tbody.insertBefore(newRow, tbody.firstChild);
        }

        // Cancel new row
        function cancelNewRow() {
            const newRow = document.getElementById('row-new');
            if (newRow) newRow.remove();
        }

        // Save new row
        async function saveNewRow() {
            const modelId = document.getElementById('modelId-new').value;
            const totalStock = document.getElementById('totalStock-new').value;
            const price = document.getElementById('price-new').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            if (!modelId || !totalStock || !price) {
                alert('Please fill all fields.');
                return;
            }

            const formData = new FormData();
            formData.append('modelId', modelId);
            formData.append('totalStock', totalStock);
            formData.append('price', price);
            formData.append('isAccumulate', true)
            formData.append('__RequestVerificationToken', token);

            const response = await fetch('/MasterStock/Index', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                window.location.reload();
            } else if (response.status === 401) {
                window.location.href = '/auth/login';
            } else {
                alert('Failed to add stock. Please try again.');
            }
        }

        // Save edit
        async function saveEdit(id, modelId) {
            const totalStock = document.getElementById(`totalStock-${id}`).value;
            const price = document.getElementById(`price-${id}`).value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('modelId', modelId);
            formData.append('totalStock', totalStock);
            formData.append('price', price);
            formData.append('__RequestVerificationToken', token);

            const response = await fetch('/MasterStock/Index', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                window.location.reload();
            } else if (response.status === 401) {
                window.location.href = '/auth/login';
            } else {
                alert('Failed to update stock. Please try again.');
            }
        }

        // Delete modal
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                document.getElementById('deleteForm').action = `/MasterStock/Delete/${id}`;
            });
        }
    </script>
}