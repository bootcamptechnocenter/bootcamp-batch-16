@using IDMS.Modules.Master.Dto.Response
@model ResDashboardDto

@{
    ViewData["Title"] = "Dashboard";
    var stockLabels = System.Text.Json.JsonSerializer.Serialize(Model.StockPerBrand.Select(x => x.BrandName));
    var stockData   = System.Text.Json.JsonSerializer.Serialize(Model.StockPerBrand.Select(x => x.ReadyCount));
}

<div class="mb-4">
    <h2 class="mb-1">Dashboard</h2>
    <p class="text-muted mb-0">Overview of stock and revenue.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <div class="card border-0 h-100" style="border-radius:1rem;box-shadow:0 4px 20px rgba(16,24,40,.08);">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10"
                     style="width:64px;height:64px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#198754" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                    </svg>
                </div>
                <div>
                    <p class="text-muted mb-1" style="font-size:.85rem;letter-spacing:.03em;">TOTAL READY STOCK</p>
                    <h2 class="mb-0 fw-bold">
                        @Model.TotalReadyStock
                        <span class="text-muted fw-normal" style="font-size:1rem;">unit</span>
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="card border-0 h-100" style="border-radius:1rem;box-shadow:0 4px 20px rgba(16,24,40,.08);">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10"
                     style="width:64px;height:64px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#0d6efd" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-muted mb-1" style="font-size:.85rem;letter-spacing:.03em;">TOTAL REVENUE (SOLD)</p>
                    <h2 class="mb-0 fw-bold" style="font-size:1.6rem;">
                        Rp @Model.TotalRevenue.ToString("N0")
                    </h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0" style="border-radius:1rem;box-shadow:0 4px 20px rgba(16,24,40,.08);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h6 class="fw-semibold mb-1">Ready Stock per Brand</h6>
                        <p class="text-muted mb-0" style="font-size:.8rem;">Number of available units per brand</p>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2" style="font-size:.8rem;">
                        @Model.TotalReadyStock unit total
                    </span>
                </div>
                <canvas id="stockChart" style="max-height:380px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* <script src="~/lib/chart.js/chart.umd.min.js"></script> *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const stockLabels = @Html.Raw(stockLabels);
        const stockData   = @Html.Raw(stockData);

        const colors = [
            '#4361ee','#3a86ff','#7209b7','#f72585',
            '#4cc9f0','#06d6a0','#ffd166','#ef476f',
            '#118ab2','#073b4c'
        ];

        new Chart(document.getElementById('stockChart'), {
            type: 'bar',
            data: {
                labels: stockLabels,
                datasets: [{
                    label: 'Ready Units',
                    data: stockData,
                    backgroundColor: stockLabels.map((_, i) => colors[i % colors.length] + '22'),
                    borderColor:     stockLabels.map((_, i) => colors[i % colors.length]),
                    borderWidth: 2,
                    borderRadius: 8,
                    borderSkipped: false,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => `  ${ctx.parsed.y} unit ready`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            font: { size: 12 }
                        },
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        border: { display: false }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 13 } },
                        border: { display: false }
                    }
                }
            }
        });
    </script>
}