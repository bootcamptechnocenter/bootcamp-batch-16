@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstModelDto>

@{
    var search = Context.Request.Query["search"].ToString();
    var items = Model?.Items ?? Enumerable.Empty<ResMstModelDto>();
    var currentPage = Model?.Pagination?.CurrentPage > 0 ? Model.Pagination.CurrentPage : 1;
    var limit = Model?.Pagination?.Limit > 0 ? Model.Pagination.Limit : 10;
    var totalPages = Model?.Pagination?.TotalPages > 0 ? Model.Pagination.TotalPages : 1;
    var totalItems = Model?.Pagination?.TotalItems ?? 0;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <p class="text-muted mb-0">Total data: <strong>@totalItems</strong></p>
    <p class="text-muted mb-0">Page <strong>@currentPage</strong> of <strong>@totalPages</strong></p>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 60px;">No</th>
                <th>Type</th>
                <th>Model Code</th>
                <th>Model Name</th>
                <th>Year</th>
                <th style="width: 170px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (items.Any())
            {
                int no = ((currentPage - 1) * limit) + 1;
                foreach (var modelData in items)
                {
                   <tr>
                        <td>@no</td>
                        <td>
                            <span class="badge bg-light text-dark border">@modelData.TypeCode</span>
                            <span class="text-muted ms-1">@modelData.TypeName</span>
                        </td>
                        <td><span class="fw-semibold">@modelData.Code</span></td>
                        <td>@modelData.Name</td>
                        <td>@modelData.Year</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@modelData.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger type-delete-btn"
                                    data-id="@modelData.Id"
                                    data-code="@Html.Encode(modelData.Code)"
                                    data-name="@Html.Encode(modelData.Name)"
                                    data-brand="@Html.Encode(modelData.TypeCode)">Delete</button>
                        </td>
                    </tr>
                    no++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No model data found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Master Model pagination">
        <ul class="pagination justify-content-end mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-limit="@limit"
                   asp-route-search="@search"
                   data-page="@(currentPage - 1)">Previous</a>
            </li>

            @for (var p = startPage; p <= endPage; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@p"
                       asp-route-limit="@limit"
                       asp-route-search="@search"
                       data-page="@p">@p</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-limit="@limit"
                   asp-route-search="@search"
                   data-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

<div class="modal fade" id="modelDeleteModal" tabindex="-1" aria-labelledby="modelDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:1rem; border:none; box-shadow:0 16px 40px rgba(16,24,40,.14);">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10"
                         style="width:48px;height:48px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#dc3545" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
                        </svg>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0 fw-semibold" id="modelDeleteModalLabel">Delete Model</h5>
                        <p class="text-muted mb-0" style="font-size:.875rem;">This action cannot be undone.</p>
                    </div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3 pb-2">
                <p class="mb-2">You are about to delete the following model:</p>
                <div class="rounded p-3 mb-1" style="background:#f8f9fa; border:1px solid #e9ecf3;">
                    <div class="d-flex gap-4">
                        <div>
                            <p class="text-muted mb-0" style="font-size:.75rem;">Brand Code</p>
                            <p class="fw-semibold mb-0" id="modelDeleteBrand">—</p>
                        </div>
                        <div>
                            <p class="text-muted mb-0" style="font-size:.75rem;">Type Code</p>
                            <p class="fw-semibold mb-0" id="modelDeleteType">—</p>
                        </div>
                        <div>
                            <p class="text-muted mb-0" style="font-size:.75rem;">Model Code</p>
                            <p class="fw-semibold mb-0" id="modelDeleteCode">—</p>
                        </div>
                        <div>
                            <p class="text-muted mb-0" style="font-size:.75rem;">Model Name</p>
                            <p class="fw-semibold mb-0" id="modelDeleteName">—</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-2 gap-2">
                <form id="modelDeleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                </form>
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>