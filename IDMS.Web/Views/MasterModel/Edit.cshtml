@model IDMS.Modules.Master.Dto.Request.ReqUpdateMstModelDto

@{
    ViewData["Title"] = "Edit Master Model";
    var selectedTypeText = ViewBag.SelectedTypeText as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">Edit Model</h2>
        <p class="text-muted mb-0">Update model details below.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0" style="border-radius:1rem; box-shadow:0 8px 24px rgba(16,24,40,.06);">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@ViewBag.ModelId" method="post">
                    @Html.AntiForgeryToken()

                    <!-- TYPE DROPDOWN -->
                    <div class="mb-3">
                        <label asp-for="TypeId" class="form-label fw-semibold">Type</label>
                        <select asp-for="TypeId"
                                class="form-select"
                                data-select2-type="true"
                                data-ajax-url="@Url.Action("TypeOptions", "MasterModel")">

                            <option value="0">-- Select Type --</option>

                            @if (Model?.TypeId > 0 && !string.IsNullOrWhiteSpace(selectedTypeText))
                            {
                                <option value="@Model.TypeId" selected>@selectedTypeText</option>
                            }
                        </select>
                        <span asp-validation-for="TypeId" class="text-danger small"></span>
                    </div>

                    <!-- CODE -->
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold"></label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <!-- NAME -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- YEAR DROPDOWN -->
                    <div class="mb-4">
                        <label asp-for="Year" class="form-label fw-semibold"></label>
                        <select asp-for="Year" class="form-select">
                            <option value="">-- Select Year --</option>
                            @{
                                var currentYear = DateTime.Now.Year;
                                for (int i = currentYear; i >= currentYear - 20; i--)
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>

                    <!-- ACTION -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/master-model-form.js" asp-append-version="true"></script>
}