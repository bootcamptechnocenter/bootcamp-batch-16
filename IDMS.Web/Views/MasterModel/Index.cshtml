@using IDMS.Modules.Master.Dto.Response
@using IDMS.Shared.Entities
@model PagedResult<ResMstModelDto>

@{
    ViewData["Title"] = "Master Model";
    var search = Context.Request.Query["search"].ToString();
}

<div class="master-model-page" style="padding: 20px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1" style="letter-spacing: -0.5px;">Master Model</h2>
            <p style="color: rgba(255,255,255,0.5); margin-bottom: 0;">Manage your vehicle models with a modern touch.
            </p>
        </div>
        <button type="button" class="btn fw-bold px-4 shadow-sm"
                style="background: #fff; color: #000; border-radius: 16px; padding: 12px 24px;"         onclick="loadCreateModal()">
            + Create New Model
        </button>
    </div>

    <div class="card border-0 mb-4"
         style="border-radius: 20px; background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-lg-8">
                    <label class="form-label fw-bold small"
                           style="color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px;">Search
                        Model</label>
                        <input id="masterModelSearch" value="@search" class="form-control text-white"
                               placeholder="Search by code or name..."
                               style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="form-label fw-bold small"
                               style="color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px;">Show</label>
                        <select id="masterModelLimit" class="form-select text-white"
                                style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;">
                            <option value="10">10 Rows</option>
                            <option value="20">20 Rows</option>
                            <option value="50">50 Rows</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <button type="button" class="btn w-100 fw-semibold" id="masterModelReset"
                                style="background: rgba(255,255,255,0.1); color: #fff; border-radius: 12px; padding: 12px;">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="masterModelGrid" data-url="@Url.Action("Table", "MasterModel")">
            <partial name="_MasterModelTable" model="Model" />
        </div>
    </div>