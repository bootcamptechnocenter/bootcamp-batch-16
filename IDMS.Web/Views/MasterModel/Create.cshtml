@model IDMS.Modules.Master.Dto.Request.ReqCreateMstModelDto
@{
    ViewData["Title"] = "Create Model";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted">&larr; Back</a>
            <h3 class="fw-bold text-white mb-0 ms-2">Add New Model</h3>
        </div>

        <div class="card border-0 shadow-lg" style="border-radius: 24px; background: rgba(255,255,255,0.03); backdrop-filter: blur(20px);">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div class="mb-4">
                        <label asp-for="TypeId" class="form-label fw-bold small text-muted text-uppercase" style="letter-spacing: 1px;">Vehicle Type</label>
                        <select asp-for="TypeId" class="form-select select2-dark" data-select2-type="true"
                                data-ajax-url="@Url.Action("TypeOptions", "MasterModel")">
                            <option value="0">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="TypeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Code" class="form-label fw-bold small text-muted text-uppercase" style="letter-spacing: 1px;">Model Code</label>
                        <input asp-for="Code" class="form-control text-white" placeholder="e.g. MDL-01" required 
                               style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold small text-muted text-uppercase" style="letter-spacing: 1px;">Model Name</label>
                        <input asp-for="Name" class="form-control text-white" placeholder="e.g. Vario 160" required 
                               style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
                    </div>

                    <div class="mb-5">
                        <label asp-for="Year" class="form-label fw-bold small text-muted text-uppercase" style="letter-spacing: 1px;">Year</label>
                        <input asp-for="Year" type="number" class="form-control text-white" placeholder="2024" required 
                               style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px;" />
                    </div>

                    <div class="d-flex gap-3">
                        <a asp-action="Index" class="btn w-50 fw-semibold"
                                style="background: rgba(255,255,255,0.1); color: #fff; border-radius: 16px; padding: 14px;">Cancel</a>
                        <button type="submit" class="btn w-50 fw-bold shadow-sm"
                                style="background: #fff; color: #000; border-radius: 16px; padding: 14px;">Save Model</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <style>
        /* Custom Select2 for Dark Theme */
        .select2-container--bootstrap-5 .select2-selection {
            background-color: rgba(255,255,255,0.05) !important;
            border: 1px solid rgba(255,255,255,0.1) !important;
            border-radius: 12px !important;
            color: white !important;
            padding: 8px !important;
            height: auto !important;
        }
        .select2-container--bootstrap-5 .select2-selection__rendered { color: white !important; }
    </style>
}