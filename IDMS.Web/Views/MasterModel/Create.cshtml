@model IDMS.Modules.Master.Dto.Request.ReqCreateMstModelDto

@{
    ViewData["Title"] = "Create Master Model";
    var selectedBrandText = ViewBag.SelectedBrandText as string;
    var selectedTypeText  = ViewBag.SelectedTypeText  as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">Create Model</h2>
        <p class="text-muted mb-0">Add a new model to the system.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0" style="border-radius:1rem;box-shadow:0 8px 24px rgba(16,24,40,.06);">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    {{!-- Brand (display only, drives Type options) --}}
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Brand</label>
                        <select id="brandSelect" class="form-select"
                                data-ajax-url="@Url.Action("BrandOptions", "MasterModel")">
                            <option value="0">-- Select Brand --</option>
                            @if (ViewBag.SelectedBrandId is int bid && bid > 0 && !string.IsNullOrWhiteSpace(selectedBrandText))
                            {
                                <option value="@bid" selected>@selectedBrandText</option>
                            }
                        </select>
                    </div>

                    {{!-- Type --}}
                    <div class="mb-3">
                        <label asp-for="TypeId" class="form-label fw-semibold">Type</label>
                        <select asp-for="TypeId" id="typeSelect" class="form-select"
                                data-ajax-url="@Url.Action("TypeOptions", "MasterModel")">
                            <option value="0">-- Select Type --</option>
                            @if (Model?.TypeId > 0 && !string.IsNullOrWhiteSpace(selectedTypeText))
                            {
                                <option value="@Model.TypeId" selected>@selectedTypeText</option>
                            }
                        </select>
                        <span asp-validation-for="TypeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold"></label>
                        <input asp-for="Code" class="form-control" placeholder="e.g. MDL-001" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Model Name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Year" class="form-label fw-semibold"></label>
                        <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2024" />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Is Active</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Model</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
}
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/master-model-form.js" asp-append-version="true"></script>
}