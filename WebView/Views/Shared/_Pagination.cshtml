@using WebApi.Shared.Entities
@model Pagination

@{
    var currentSearch = ViewData["Search"]?.ToString() ?? "";
    var currentLimit = ViewData["Limit"]?.ToString() ?? "10";
    var actionName = ViewData["Action"]?.ToString() ?? "Index";
    var controllerName = ViewData["Controller"]?.ToString();
}

<div class="row mt-3">
    <div class="col-md-6">
        <p class="text-muted">
            Showing @((Model.CurrentPage - 1) * Model.Limit + 1)
            to @(Math.Min(Model.CurrentPage * Model.Limit, Model.TotalItems))
            of @Model.TotalItems items
        </p>
    </div>
    <div class="col-md-6">
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-end mb-0">
                    <!-- Previous Button -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        @if (string.IsNullOrEmpty(controllerName))
                        {
                            <a class="page-link"
                                   href="@Url.Action(actionName, new { search = currentSearch, page = Model.CurrentPage - 1, limit = currentLimit })"
                                   aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        }
                        else
                        {
                            <a class="page-link"
                                   href="@Url.Action(actionName, controllerName, new { search = currentSearch, page = Model.CurrentPage - 1, limit = currentLimit })"
                                   aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        }
                    </li>

                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        // Show first page if not in range
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                @if (string.IsNullOrEmpty(controllerName))
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, new { search = currentSearch, page = 1, limit = currentLimit })">1</a>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, controllerName, new { search = currentSearch, page = 1, limit = currentLimit })">1</a>
                                }
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        // Page numbers
                        for (int i = startPage; i <= endPage; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == Model.CurrentPage ? "active" : "")">
                                @if (string.IsNullOrEmpty(controllerName))
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, new { search = currentSearch, page = pageNum, limit = currentLimit })">@pageNum</a>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, controllerName, new { search = currentSearch, page = pageNum, limit = currentLimit })">@pageNum</a>
                                }
                            </li>
                        }

                        // Show last page if not in range
                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                @if (string.IsNullOrEmpty(controllerName))
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, new { search = currentSearch, page = Model.TotalPages, limit = currentLimit })">@Model.TotalPages</a>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="@Url.Action(actionName, controllerName, new { search = currentSearch, page = Model.TotalPages, limit = currentLimit })">@Model.TotalPages</a>
                                }
                            </li>
                        }
                    }

                    <!-- Next Button -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        @if (string.IsNullOrEmpty(controllerName))
                        {
                            <a class="page-link"
                                   href="@Url.Action(actionName, new { search = currentSearch, page = Model.CurrentPage + 1, limit = currentLimit })"
                                   aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        }
                        else
                        {
                            <a class="page-link"
                                   href="@Url.Action(actionName, controllerName, new { search = currentSearch, page = Model.CurrentPage + 1, limit = currentLimit })"
                                   aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>