@using WebApi.Modules.Master.Dto.Request;
@model ReqMstModelUpdateDto

@{
    ViewData["Title"] = "Edit Model";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var modelId = ViewBag.ModelId;
}

<h1>Edit Model</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Edit" asp-route-id="@modelId" method="post">
                    <div class="mb-3">
                        <label asp-for="TypeId" class="form-label">Model Type</label>
                        <select name="TypeId" class="form-select">
                            <option value="">Select model type</option>
                            @foreach (var type in ViewBag.Types)
                            {
                                <option value="@type.Id" selected="@(Model.TypeId == type.Id)">@type.Name</option>
                            }
                        </select>
                        <span asp-validation-for="TypeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">Model Code</label>
                        <input asp-for="Code" class="form-control" placeholder="Enter model code" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Model Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter model name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Year" class="form-label">Model Year</label>
                        <input asp-for="Year" class="form-control" placeholder="Enter model year" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" id="IsActive" checked="@(Model.IsActive ?? true)" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label for="IsActive" class="form-check-label">Active</label>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
