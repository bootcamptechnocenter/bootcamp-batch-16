@using WebApi.Modules.Master.Dto.Response;
@using WebApi.Shared.Entities;
@model PagedResult<ResMstStockDto>

@{
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentLimit = Context.Request.Query["limit"].ToString();
    if (string.IsNullOrEmpty(currentLimit)) currentLimit = "5";

    ViewData["Search"] = currentSearch;
    ViewData["Limit"] = currentLimit;
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th style="width: 80px;">No</th>
            <th>Name</th>
            <th class="text-center">Stock</th>
            <th class="text-end">Price</th>
            <th style="width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())
        {
            var no = ((Model.Pagination.CurrentPage - 1) * Model.Pagination.Limit) + 1;
            foreach (var item in Model.Items)
            {
                var displayName = string.IsNullOrWhiteSpace(item.Name)
                    ? string.Join(" ", new[] { item.BrandName, item.TypeName, item.ModelName }.Where(x => !string.IsNullOrWhiteSpace(x)))
                    : item.Name;
                <tr>
                    <td>@no</td>
                    <td>@displayName</td>
                    <td class="text-center">@item.Stock</td>
                    <td class="text-end">@item.Price</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                no++;
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No data found</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
<partial name="_Pagination" model="Model.Pagination" />
