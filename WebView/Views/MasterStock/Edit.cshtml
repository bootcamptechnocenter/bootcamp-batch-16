@using WebApi.Modules.Master.Dto.Request;
@using Microsoft.AspNetCore.Mvc.Rendering;
@model ReqMstStockUpdateDto

@{
    ViewData["Title"] = "Edit Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stockId = ViewBag.StockId;
    var models = ViewBag.Models as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1>Edit Stock</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Edit" asp-route-id="@stockId" method="post">
                    <div class="mb-3">
                        <label asp-for="ModelId" class="form-label">Model</label>
                        <select name="ModelId" class="form-select js-model-select">
                            <option value="">Select model</option>
                            @foreach (var item in models)
                            {
                                <option value="@item.Value" selected="@(Model.ModelId?.ToString() == item.Value)">@item.Text
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ModelId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Stock" class="form-label">Stock</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="Enter stock" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Price</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0"
                               placeholder="Enter price" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
            $(function () {
                $('.js-model-select').select2({ width: '100%' });
            });
    </script>
}