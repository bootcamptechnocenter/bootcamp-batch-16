@using WebApi.Modules.Master.Dto.Request;
@model ReqMstTypeUpdateDto

@{
    ViewData["Title"] = "Edit Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var typeId = ViewBag.TypeId;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Edit Type</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Edit" asp-route-id="@typeId" method="post">
                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label">Type Brand</label>
                        <select name="BrandId" class="form-select">
                            <option value="">Select type brand</option>
                            @foreach (var brand in ViewBag.Brands)
                            {
                                <option value="@brand.Id" selected="@(Model.BrandId == brand.Id)">@brand.Name</option>
                            }
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">Type Code</label>
                        <input asp-for="Code" class="form-control" placeholder="Enter type code" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Type Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter type name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" id="IsActive"
                               checked="@(Model.IsActive ?? true)" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label for="IsActive" class="form-check-label">Active</label>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}