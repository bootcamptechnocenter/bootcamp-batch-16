{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WebApiDb;User Id=sa;Password=your_password;"
  },
  "Jwt": {
    "Key": "your_secret_key_here",
    "Issuer": "WebApi",
    "Audience": "WebApi-Client",
    "ExpireInMinutes": 60
  },
  "Security": {
    "ApiKey": "your_api_key_here"
  }
}
